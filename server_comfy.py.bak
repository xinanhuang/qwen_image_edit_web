#!/usr/bin/env python3
"""
Qwen-Image-Edit-2511 Web Server (ComfyUI Backend)
Uses ComfyUI with fp8 models that fit on 24GB GPUs (RTX 3090).
"""

import io
import os
import sys
import json
import time
import uuid
import base64
import socket
import threading
import urllib.request
import urllib.parse
import websocket  # websocket-client
import torch
from PIL import Image
from flask import Flask, request, jsonify, render_template, send_from_directory

app = Flask(__name__, template_folder="templates", static_folder="static")

# --- Config ---
COMFYUI_HOST = os.environ.get("COMFYUI_HOST", "127.0.0.1")
COMFYUI_PORT = int(os.environ.get("COMFYUI_PORT", "8188"))
COMFYUI_URL = f"http://{COMFYUI_HOST}:{COMFYUI_PORT}"
OUTPUT_DIR = os.path.join(os.path.dirname(__file__), "outputs")
os.makedirs(OUTPUT_DIR, exist_ok=True)

# Job tracking: client_id -> {step, total, status, message, percent, result}
job_progress = {}


def build_workflow(input_image_name, prompt, negative_prompt, num_steps, guidance, cfg_scale, seed, num_images, use_lightning=False):
    """Build a ComfyUI workflow JSON for Qwen-Image-Edit-2511 with fp8 models.
    
    Based on the official Comfy-Org workflow structure:
    UNETLoader → [LoraLoaderModelOnly] → ModelSamplingAuraFlow → CFGNorm → KSampler
    CLIPLoader → TextEncodeQwenImageEditPlus (positive/negative)
    VAELoader → VAEEncode (input image) → KSampler → VAEDecode → SaveImage
    ImageScaleToTotalPixels for input preprocessing
    """
    # Lightning settings: 4 steps, cfg 1.0
    if use_lightning:
        num_steps = 4
        cfg_scale = 1.0
        
    workflow = {
        # UNET Loader (fp8 transformer)
        "37": {
            "class_type": "UNETLoader",
            "inputs": {
                "unet_name": "qwen_image_edit_2511_fp8_e4m3fn.safetensors",
                "weight_dtype": "fp8_e4m3fn"
            }
        },
        # CLIP Loader (fp8 text encoder)
        "38": {
            "class_type": "CLIPLoader",
            "inputs": {
                "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
                "type": "qwen_image",
                "device": "default"
            }
        },
        # VAE Loader
        "39": {
            "class_type": "VAELoader",
            "inputs": {
                "vae_name": "qwen_image_vae.safetensors"
            }
        },
        # Upload image
        "78": {
            "class_type": "LoadImage",
            "inputs": {
                "image": input_image_name
            }
        },
        # Scale input image to reasonable size
        "93": {
            "class_type": "ImageScaleToTotalPixels",
            "inputs": {
                "upscale_method": "lanczos",
                "megapixels": 1.0,
                "resolution_steps": 1,
                "image": ["78", 0]
            }
        },
        # Encode input image to latent
        "88": {
            "class_type": "VAEEncode",
            "inputs": {
                "pixels": ["93", 0],
                "vae": ["39", 0]
            }
        },
        # Positive Conditioning
        "101": {
            "class_type": "TextEncodeQwenImageEditPlus",
            "inputs": {
                "prompt": prompt,
                "clip": ["38", 0],
                "vae": ["39", 0],
                "image1": ["93", 0]
            }
        },
        # Negative Conditioning
        "102": {
            "class_type": "TextEncodeQwenImageEditPlus",
            "inputs": {
                "prompt": negative_prompt,
                "clip": ["38", 0],
                "vae": ["39", 0],
                "image1": ["93", 0]
            }
        },
    }
    
    # Model chain: UNET → [LoRA] → AuraFlow → CFGNorm → KSampler
    if use_lightning:
        # Add Lightning LoRA
        workflow["89"] = {
            "class_type": "LoraLoaderModelOnly",
            "inputs": {
                "model": ["37", 0],
                "lora_name": "Qwen-Image-Edit-2511-Lightning-4steps-V1.0.safetensors",
                "strength_model": 1.0
            }
        }
        # AuraFlow after LoRA
        workflow["66"] = {
            "class_type": "ModelSamplingAuraFlow",
            "inputs": {
                "shift": 3,
                "model": ["89", 0]
            }
        }
    else:
        # AuraFlow directly after UNET
        workflow["66"] = {
            "class_type": "ModelSamplingAuraFlow",
            "inputs": {
                "shift": 3,
                "model": ["37", 0]
            }
        }
    
    # CFGNorm
    workflow["75"] = {
        "class_type": "CFGNorm",
        "inputs": {
            "strength": 1,
            "model": ["66", 0]
        }
    }
    
    # KSampler
    workflow["3"] = {
        "class_type": "KSampler",
        "inputs": {
            "seed": seed,
            "steps": num_steps,
            "cfg": cfg_scale,
            "sampler_name": "euler",
            "scheduler": "simple",
            "denoise": 1.0,
            "model": ["75", 0],
            "positive": ["101", 0],
            "negative": ["102", 0],
            "latent_image": ["88", 0]
        }
    }
    
    # VAE Decode
    workflow["8"] = {
        "class_type": "VAEDecode",
        "inputs": {
            "samples": ["3", 0],
            "vae": ["39", 0]
        }
    }
    
    # Save Image
    workflow["60"] = {
        "class_type": "SaveImage",
        "inputs": {
            "images": ["8", 0],
            "filename_prefix": "qwen_edit"
        }
    }
    return workflow


def upload_image_to_comfyui(image_b64):
    """Upload an image to ComfyUI's input directory. Returns the filename."""
    img_data = base64.b64decode(image_b64)
    filename = f"input_{uuid.uuid4().hex[:8]}.png"
    
    boundary = uuid.uuid4().hex
    body = []
    body.append(f"--{boundary}".encode())
    body.append(f'Content-Disposition: form-data; name="image"; filename="{filename}"'.encode())
    body.append(b"Content-Type: image/png")
    body.append(b"")
    body.append(img_data)
    body.append(f"--{boundary}".encode())
    body.append(b'Content-Disposition: form-data; name="type"')
    body.append(b"")
    body.append(b"input")
    body.append(f"--{boundary}--".encode())
    body.append(b"")
    
    upload_body = b"\r\n".join(body)
    
    upload_req = urllib.request.Request(
        f"{COMFYUI_URL}/upload/image",
        data=upload_body,
        headers={"Content-Type": f"multipart/form-data; boundary={boundary}"},
        method="POST"
    )
    
    try:
        with urllib.request.urlopen(upload_req, timeout=30) as resp:
            upload_result = json.loads(resp.read())
            print(f"[UPLOAD] {filename} -> {upload_result}")
            return filename
    except Exception as e:
        print(f"[UPLOAD] Error uploading {filename}: {e}")
        return filename  # Return filename anyway, LoadImage might still find it


def run_comfyui_workflow(workflow, client_id):
    """Submit a workflow to ComfyUI and wait for completion."""
    
    # Submit the workflow
    prompt_data = {
        "prompt": workflow,
        "client_id": client_id
    }
    
    req = urllib.request.Request(
        f"{COMFYUI_URL}/api/prompt",
        data=json.dumps(prompt_data).encode(),
        headers={"Content-Type": "application/json"},
        method="POST"
    )
    
    with urllib.request.urlopen(req, timeout=30) as resp:
        prompt_id = json.loads(resp.read())["prompt_id"]
        print(f"[PROMPT] ID: {prompt_id}")
    
    # Connect via WebSocket to get progress
    ws = websocket.WebSocket()
    ws.connect(f"ws://{COMFYUI_HOST}:{COMFYUI_PORT}/ws?clientId={client_id}")
    ws.settimeout(5.0)  # 5-second timeout for recv
    
    output_images = []
    current_step = 0
    total_steps = workflow.get("3", {}).get("inputs", {}).get("steps", 20)
    ws_complete = False
    
    # Initialize progress tracking
    job_progress[client_id] = {
        "step": 0,
        "total": total_steps,
        "status": "running",
        "message": "Starting..."
    }
    
    # Track when sampling finishes (step == total)
    sampling_done = False
    
    try:
        while True:
            # Use timeout to periodically check history API
            try:
                out = ws.recv()
            except (websocket._exceptions.WebSocketTimeoutException, TimeoutError, socket.timeout):
                # Periodically check if job is done via history API
                if sampling_done:
                    print(f"[WS] Sampling done, checking history...")
                    history_req = urllib.request.Request(f"{COMFYUI_URL}/api/history/{prompt_id}")
                    with urllib.request.urlopen(history_req, timeout=10) as resp:
                        history = json.loads(resp.read())
                    if prompt_id in history and "outputs" in history[prompt_id]:
                        print(f"[WS] Job found in history, fetching results")
                        ws_complete = True
                        break
                out = None
            
            if out is None:
                continue
                
            if isinstance(out, str):
                msg = json.loads(out)
                msg_type = msg.get("type")
                data = msg.get("data", {})
                
                if msg_type == "progress_state":
                    # Extract KSampler progress (node "3")
                    nodes = data.get("nodes", {})
                    for nid, nstate in nodes.items():
                        if nid == "3":  # KSampler node
                            value = nstate.get("value", 0)
                            max_val = nstate.get("max", total_steps)
                            state = nstate.get("state", "running")
                            current_step = int(value)
                            total_steps = int(max_val)
                            pct = round(current_step / total_steps * 100, 1) if total_steps > 0 else 0
                            job_progress[client_id].update({
                                "step": current_step,
                                "total": total_steps,
                                "status": "sampling",
                                "message": f"Step {current_step}/{total_steps} ({pct}%)",
                                "percent": pct
                            })
                            print(f"[PROGRESS] Step {current_step}/{total_steps} ({pct}%)")
                            # Check if sampling is done
                            if current_step >= total_steps:
                                sampling_done = True
                            break
                        elif nstate.get("state") == "running":
                            job_progress[client_id].update({
                                "status": "running",
                                "message": f"Running node {nid}..."
                            })
                        elif nstate.get("state") == "finished":
                            if nid == "60":  # SaveImage
                                job_progress[client_id].update({
                                    "status": "saving",
                                    "message": "Saving result...",
                                    "percent": 100
                                })
                                ws_complete = True
                
                elif msg_type == "executing":
                    node_id = data.get("node")
                    prompt_id_field = data.get("prompt_id")
                    stage = data.get("stage")
                    
                    if node_id is None and (stage == "complete" or prompt_id_field == prompt_id):
                        print(f"[WS] Execution complete")
                        time.sleep(2)
                        ws_complete = True
                        break
                    elif stage == "executed" and node_id == "60":
                        print(f"[WS] SaveImage node completed")
                        time.sleep(2)
                        ws_complete = True
                        break
                    elif node_id == "3":  # KSampler started
                        job_progress[client_id].update({
                            "status": "sampling",
                            "message": "Sampling started...",
                            "step": 0,
                            "total": total_steps
                        })
            elif isinstance(out, bytes):
                pass
        
        # Fetch results from history
        print(f"[WS] Fetching results from history (ws_complete={ws_complete})")
        time.sleep(2)  # Give ComfyUI time to save outputs
        
        for attempt in range(5):
            try:
                history_req = urllib.request.Request(f"{COMFYUI_URL}/api/history/{prompt_id}")
                with urllib.request.urlopen(history_req, timeout=30) as resp:
                    history = json.loads(resp.read())
                if prompt_id in history and "outputs" in history[prompt_id]:
                    outputs = history[prompt_id]["outputs"]
                    for node_id, node_output in outputs.items():
                        if "images" in node_output:
                            for img_info in node_output["images"]:
                                img_name = img_info["filename"]
                                subfolder = img_info.get("subfolder", "")
                                img_type = img_info.get("type", "output")
                                img_url = f"{COMFYUI_URL}/view?filename={img_name}&subfolder={subfolder}&type={img_type}"
                                print(f"[OUTPUT] Fetching {img_url}")
                                with urllib.request.urlopen(img_url) as img_resp:
                                    img_data = img_resp.read()
                                    output_images.append(img_data)
                    break
                else:
                    print(f"[WS] History not ready, attempt {attempt+1}/5")
                    time.sleep(2)
            except Exception as e:
                print(f"[WS] History fetch error: {e}, attempt {attempt+1}/5")
                time.sleep(2)
    finally:
        ws.close()
    
    return output_images


# --- Routes ---

@app.route("/")
def index():
    return render_template("index.html")


@app.route("/api/status", methods=["GET"])
def status():
    """Return server status."""
    comfyui_ready = False
    try:
        req = urllib.request.Request(f"{COMFYUI_URL}/api/system_stats")
        with urllib.request.urlopen(req, timeout=5) as resp:
            comfyui_ready = resp.status == 200
    except:
        pass
    
    return jsonify({
        "model_loaded": comfyui_ready,
        "gpu_available": torch.cuda.is_available(),
        "gpu_name": torch.cuda.get_device_name(0) if torch.cuda.is_available() else "CPU",
        "gpu_memory": round(torch.cuda.get_device_properties(0).total_memory / 1e9, 1) if torch.cuda.is_available() else 0,
        "comfyui_url": COMFYUI_URL,
    })


@app.route("/api/progress/<client_id>", methods=["GET"])
def get_progress(client_id):
    """Get progress for a running job."""
    if client_id in job_progress:
        return jsonify(job_progress[client_id])
    return jsonify({"status": "idle", "message": "No progress data"})


def run_edit_job(client_id, workflow, job_id):
    """Background thread to run the ComfyUI workflow."""
    start_time = time.time()
    try:
        output_images = run_comfyui_workflow(workflow, client_id)
        elapsed = round(time.time() - start_time, 1)
        
        if not output_images:
            job_progress[client_id].update({
                "status": "error",
                "message": "No output images generated",
                "elapsed": elapsed,
                "result": None
            })
            return
        
        results = []
        for i, img_data in enumerate(output_images):
            output_path = os.path.join(OUTPUT_DIR, f"{job_id}_{i}.png")
            with open(output_path, "wb") as f:
                f.write(img_data)
            
            b64 = base64.b64encode(img_data).decode()
            results.append(f"data:image/png;base64,{b64}")
        
        print(f"[{job_id}] Done in {elapsed}s")
        job_progress[client_id].update({
            "status": "complete",
            "message": f"Done in {elapsed}s",
            "elapsed": elapsed,
            "percent": 100,
            "result": {
                "success": True,
                "job_id": job_id,
                "elapsed": elapsed,
                "images": results,
                "output_url": f"/outputs/{job_id}_0.png",
            }
        })
    
    except Exception as e:
        elapsed = round(time.time() - start_time, 1)
        print(f"[{job_id}] Error after {elapsed}s: {e}")
        import traceback
        traceback.print_exc()
        job_progress[client_id].update({
            "status": "error",
            "message": str(e),
            "elapsed": elapsed,
            "result": {
                "success": False,
                "error": str(e),
                "elapsed": elapsed,
            }
        })


@app.route("/api/edit", methods=["POST"])
def edit_image():
    """Edit an image using ComfyUI + Qwen-Image-Edit-2511."""
    data = request.form.to_dict()
    prompt = data.get("prompt", "").strip()
    negative_prompt = data.get("negative_prompt", " ").strip() or " "
    
    try:
        num_inference_steps = int(data.get("num_inference_steps", 20))
        guidance_scale = float(data.get("guidance_scale", 1.0))
        true_cfg_scale = float(data.get("true_cfg_scale", 4.0))
        seed = int(data.get("seed", 42))
        num_images = int(data.get("num_images", 1))
        use_lightning = data.get("use_lightning", "false").lower() == "true"
    except (ValueError, TypeError):
        num_inference_steps = 20
        guidance_scale = 1.0
        true_cfg_scale = 4.0
        seed = 42
        num_images = 1
        use_lightning = False
    
    if not prompt:
        return jsonify({"error": "Prompt is required"}), 400
    
    # Get image
    image_b64 = data.get("image_base64", "")
    if image_b64:
        if "," in image_b64:
            image_b64 = image_b64.split(",", 1)[1]
    else:
        return jsonify({"error": "Image is required"}), 400
    
    job_id = str(uuid.uuid4())[:8]
    client_id = str(uuid.uuid4())
    
    print(f"\n[{job_id}] Editing: {prompt[:80]}...")
    
    # Upload image to ComfyUI first
    input_filename = upload_image_to_comfyui(image_b64)
    print(f"[{job_id}] Uploaded as: {input_filename}")
    
    workflow = build_workflow(
        input_filename, prompt, negative_prompt,
        num_inference_steps, guidance_scale, true_cfg_scale, seed, num_images,
        use_lightning
    )
    
    # Start background thread
    thread = threading.Thread(
        target=run_edit_job,
        args=(client_id, workflow, job_id),
        daemon=True
    )
    thread.start()
    
    return jsonify({
        "client_id": client_id,
        "job_id": job_id,
        "status": "queued",
    })


@app.route("/outputs/<filename>")
def serve_output(filename):
    return send_from_directory(OUTPUT_DIR, filename)


if __name__ == "__main__":
    port = int(os.environ.get("PORT", 7860))
    host = os.environ.get("HOST", "0.0.0.0")
    print(f"\n{'='*60}")
    print(f"  Qwen-Image-Edit-2511 Web Server (ComfyUI Backend)")
    print(f"  ComfyUI: {COMFYUI_URL}")
    print(f"{'='*60}")
    print(f"\nStarting server on http://{host}:{port}")
    print(f"Open this URL on your phone or browser to begin.\n")
    app.run(host=host, port=port, threaded=True, debug=False)
